# Generate a Fernet key with:
# uv run python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
SETTINGS_ENCRYPTION_KEY=the-complete-44-character-value
API_KEY_PEPPER=replace-with-a-random-32-byte-or-longer-secret

# Compose uses these passwords to build the internal PostgreSQL URLs.
POSTGRES_PASSWORD=replace-this-postgres-password
PROXY_DATABASE_PASSWORD=replace-this-proxy-password
DATABASE_URL=postgresql+asyncpg://prismux_app:replace-this-proxy-password@supabase-db:5432/postgres
DATABASE_MIGRATION_URL=postgresql+asyncpg://postgres:replace-this-postgres-password@supabase-db:5432/postgres
DATABASE_POOL_SIZE=10
DATABASE_MAX_OVERFLOW=10

# Supabase Auth. Public registration stays disabled.
SUPABASE_AUTH_URL=http://supabase-auth:9999
SUPABASE_PUBLIC_URL=http://localhost:8100
SUPABASE_JWT_SECRET=replace-this-jwt-secret-with-at-least-32-characters
SUPABASE_JWT_ISSUER=prismux
# Supabase Studio is published on localhost only. Change PUBLIC_URL when an
# administrator reaches it through an authenticated TLS tunnel or proxy.
SUPABASE_STUDIO_PORT=8083
SUPABASE_STUDIO_PUBLIC_URL=http://localhost:8083
SUPABASE_STUDIO_ORGANIZATION=PRISMUX
SUPABASE_STUDIO_PROJECT=PRISMUX
# Studio uses HTTP Basic Auth even though it is bound to localhost. Passwords
# must contain at least one letter. Use a long, unique value in production.
DASHBOARD_USERNAME=prismux-admin
DASHBOARD_PASSWORD=replace-with-a-long-random-studio-password
# Supabase Storage uses a persistent Docker named volume by default.
STORAGE_FILE_SIZE_LIMIT=52428800
STORAGE_BUCKET_DIRECTORY=stub
STORAGE_TENANT_ID=stub
STORAGE_REGION=local
SECURITY_ENABLED=true
COOKIE_SECURE=false
COOKIE_DOMAIN=
TRUSTED_PROXY_CIDRS=127.0.0.1/32,::1/128

# Created once when Auth has no user with this email. Change both values.
BOOTSTRAP_ADMIN_EMAIL=admin@example.com
BOOTSTRAP_ADMIN_PASSWORD=replace-this-bootstrap-admin-password

# Provider destinations are allowed unless explicitly blocked below. Cloud
# metadata destinations remain permanently blocked regardless of these values.
OUTBOUND_DISALLOWED_HOSTS=
OUTBOUND_DISALLOWED_CIDRS=
OUTBOUND_DISALLOWED_PORTS=22,25,53,2375,2376,5432,6379

API_KEY=your-provider-key
BASE_URL=https://integrate.api.nvidia.com/v1
MODELS_URL=
DEFAULT_MODEL=
RATE_LIMIT_RPM=40
BUCKET_CAPACITY=1
PROXY_PORT=8100
RETENTION_HOURS=24
PAYLOAD_RETENTION_DAYS=7
STATS_RETENTION_DAYS=365
ALERT_QUEUE_SECONDS=30
ALERT_ERROR_RATE_PCT=10
ALERT_RPM_PCT=80
# OPENAI_API_KEY / OPENAI_BASE_URL and NVIDIA_API_KEY / NVIDIA_BASE_URL
# remain supported as backwards-compatible aliases for API_KEY / BASE_URL.
